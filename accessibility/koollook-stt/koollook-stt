#!/usr/bin/env bash
# Koollook STT: local English dictation → clip buffer → Plasma 6 widget.
set -euo pipefail

RESONIDER="${RESONIDER:-/opt/Grok/ResoNider}"
WHISPER_BIN="${WHISPER_BIN:-$RESONIDER/third_party/whisper.cpp/build-en-best/bin/whisper-stream}"
MODEL="${KOOLLOOK_STT_MODEL:-$RESONIDER/models/ggml-tiny.en-q5_1.bin}"
LANG="${KOOLLOOK_STT_LANG:-en}"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
PIDFILE="$RUNTIME/koollook-stt.pid"
LOG="${KOOLLOOK_STT_LOG:-$RUNTIME/koollook-stt.log}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/koollook"
CLIP="$STATE/clip.txt"
STATUS_FILE="$STATE/status"
COMMANDS_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/koollook/stt-commands.json"

mkdir -p "$STATE" "$(dirname "$COMMANDS_JSON")"
[[ -f "$CLIP" ]] || : >"$CLIP"

usage() {
  cat <<'U'
Usage: koollook-stt [--start|--stop|--status|--toggle|--list-sources]
                    [--clear-clip|--send-clip|--ingest TEXT]
                    [--write-commands-json JSON]
Clip: ~/.local/state/koollook/clip.txt
Commands: ~/.config/koollook/stt-commands.json
U
}

ensure_commands_json() {
  mkdir -p "$(dirname "$COMMANDS_JSON")"
  if [[ ! -f "$COMMANDS_JSON" ]]; then
    local def
    def="$(cd "$(dirname "$0")" && pwd)/commands.default.json"
    if [[ -f "$def" ]]; then
      cp -a "$def" "$COMMANDS_JSON"
    else
      printf '%s\n' '{"hard":[{"id":"clear-clip","name":"Delete clip","match":"delete clip","builtin":"clear-clip"},{"id":"send-clip","name":"Send clip","match":"send clip","builtin":"send-clip"}],"custom":[]}' >"$COMMANDS_JSON"
    fi
  fi
}

do_write_commands_json() {
  mkdir -p "$(dirname "$COMMANDS_JSON")"
  printf '%s\n' "$1" >"$COMMANDS_JSON"
  echo "commands written $COMMANDS_JSON"
}

match_command() {
  python3 - "$COMMANDS_JSON" "$1" <<'PY'
import json, re, sys
from pathlib import Path
path, uttered = sys.argv[1], sys.argv[2]
def norm(s):
    s = re.sub(r"[^a-z0-9 ]+", " ", s.lower())
    return re.sub(r" +", " ", s).strip()
n = norm(uttered)
try:
    data = json.loads(Path(path).read_text())
except Exception:
    print("NONE")
    raise SystemExit(0)
for item in data.get("hard") or []:
    m = norm(item.get("match") or "")
    if m and m in n:
        print("BUILTIN", item.get("builtin") or "")
        print("REST", n.replace(m, " ", 1).strip())
        raise SystemExit(0)
for item in data.get("custom") or []:
    m = norm(item.get("match") or "")
    if m and m in n:
        print("RUN", item.get("command") or "")
        raise SystemExit(0)
print("NONE")
PY
}

list_sources() {
  command -v pactl >/dev/null || { echo "pactl not found"; return 1; }
  pactl list sources short
}

pick_source() {
  local want="${KOOLLOOK_STT_SOURCE:-auto}"
  command -v pactl >/dev/null || return 0
  if [[ "$want" != "auto" && -n "$want" ]]; then
    printf '%s' "$want"
    return 0
  fi
  pactl list sources short 2>/dev/null | awk '{print $2}' | grep -iE 'kdeconnect' | head -1 || true
}

type_text() {
  local t="$1"
  [[ -z "$t" ]] && return 0
  if command -v wtype >/dev/null; then wtype -- "$t"; return 0; fi
  if command -v ydotool >/dev/null; then ydotool type -- "$t"; return 0; fi
  if command -v xdotool >/dev/null; then xdotool type --delay 8 -- "$t"; return 0; fi
  if command -v wl-copy >/dev/null; then
    printf '%s' "$t" | wl-copy
    notify-send -a Koollook "STT" "Clip copied (install wtype to type it)" 2>/dev/null || true
    return 0
  fi
  return 1
}

clip_write() {
  local tmp
  tmp="$(mktemp "$STATE/clip.XXXXXX")"
  printf '%s' "$1" >"$tmp"
  mv -f "$tmp" "$CLIP"
}

clip_read() {
  [[ -f "$CLIP" ]] && cat "$CLIP" || true
}

clip_append() {
  local add="$1" cur
  cur="$(clip_read)"
  if [[ -z "$cur" ]]; then clip_write "$add"; else clip_write "$cur $add"; fi
}

do_clear_clip() {
  clip_write ""
  echo "idle" >"$STATUS_FILE"
  echo "clip cleared"
  notify-send -a Koollook "STT" "Clip deleted" 2>/dev/null || true
}

do_send_clip() {
  local t
  t="$(clip_read)"
  t="${t%"${t##*[![:space:]]}"}"
  if [[ -z "$t" ]]; then echo "clip empty"; return 0; fi
  printf '%s' "$t" >"$STATE/last-sent.txt"
  command -v wl-copy >/dev/null && printf '%s' "$t" | wl-copy || true
  type_text "$t" || true
  clip_write ""
  echo "sent" >"$STATUS_FILE"
  echo "clip sent"
  notify-send -a Koollook "STT" "Clip sent" 2>/dev/null || true
}

keep_text() {
  local t="$1"
  t="$(printf '%s' "$t" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [[ -z "$t" ]] && return 1
  case "$t" in
    "[Start speaking]"|"[BLANK_AUDIO]"|"[blank audio]"|"[Music]"|"[music]"|"[Silence]"|"[BLANK]") return 1 ;;
  esac
  [[ "$t" =~ ^\[.*\]$ ]] && return 1
  printf '%s' "$t"
}

handle_utterance() {
  local out="$1" result kind payload rest=""
  ensure_commands_json
  result="$(match_command "$out" || true)"
  kind="$(printf '%s\n' "$result" | awk 'NR==1{print $1}')"
  payload="$(printf '%s\n' "$result" | awk 'NR==1{ $1=""; sub(/^ /,""); print }')"
  rest="$(printf '%s\n' "$result" | awk 'NR==2 && $1=="REST"{ $1=""; sub(/^ /,""); print }')"
  case "$kind" in
    BUILTIN)
      case "$payload" in
        clear-clip) do_clear_clip ;;
        send-clip)
          [[ -n "$rest" ]] && clip_append "$rest"
          do_send_clip
          ;;
        *) clip_append "$out" ;;
      esac
      ;;
    RUN)
      if [[ -n "$payload" ]]; then
        bash -lc "$payload" >/dev/null 2>&1 &
        notify-send -a Koollook "STT" "Ran command" 2>/dev/null || true
      fi
      ;;
    *) clip_append "$out" ;;
  esac
}

is_running() {
  [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

do_stop() {
  if [[ -f "$PIDFILE" ]]; then
    local p
    p="$(cat "$PIDFILE")"
    kill "$p" 2>/dev/null || true
    pkill -P "$p" 2>/dev/null || true
    rm -f "$PIDFILE"
  fi
  echo "stopped" >"$STATUS_FILE"
  echo "koollook-stt stopped"
}

do_status() {
  if is_running; then
    echo "running pid=$(cat "$PIDFILE")"
    echo "listening" >"$STATUS_FILE"
    return 0
  fi
  echo "stopped"
  echo "stopped" >"$STATUS_FILE"
  return 1
}

do_start() {
  if is_running; then
    echo "already running pid=$(cat "$PIDFILE")"
    return 0
  fi
  [[ -x "$WHISPER_BIN" ]] || { echo "missing $WHISPER_BIN" >&2; exit 1; }
  [[ -f "$MODEL" ]] || { echo "missing model $MODEL" >&2; exit 1; }
  local src
  src="$(pick_source || true)"
  if [[ -n "$src" ]]; then
    export PULSE_SOURCE="$src"
    echo "audio source: $src"
  else
    echo "audio source: default Pulse/PipeWire input"
  fi
  export LD_LIBRARY_PATH="$(dirname "$WHISPER_BIN"):${LD_LIBRARY_PATH:-}"
  mkdir -p "$(dirname "$PIDFILE")" "$STATE"
  echo "listening" >"$STATUS_FILE"
  (
    local buf="" in_block=0
    "$WHISPER_BIN" -m "$MODEL" -l "$LANG" --step 800 --length 5000 --keep 200 \
      --threads "${KOOLLOOK_STT_THREADS:-4}" \
      2>>"$LOG" | while IFS= read -r line; do
        if [[ "$line" == "### Transcription "*START* ]]; then
          in_block=1; buf=""; continue
        fi
        if [[ "$line" == "### Transcription "*END* ]]; then
          in_block=0
          local out
          out="$(keep_text "$buf" || true)"
          if [[ -n "$out" ]]; then
            handle_utterance "$out" || true
            printf 'clip: %s\n' "$out" >>"$LOG"
          fi
          buf=""; continue
        fi
        if [[ $in_block -eq 1 ]]; then buf+="$line"; fi
      done
  ) &
  echo $! >"$PIDFILE"
  echo "koollook-stt started pid=$(cat "$PIDFILE") clip=$CLIP"
  notify-send -a Koollook "STT" "Listening — buffer in STT clip widget" 2>/dev/null || true
}

ensure_commands_json
cmd="${1:---start}"
case "$cmd" in
  -h|--help) usage ;;
  --list-sources) list_sources ;;
  --stop) do_stop ;;
  --status) do_status ;;
  --clear-clip|--delete-clip) do_clear_clip ;;
  --send-clip) do_send_clip ;;
  --write-commands-json) do_write_commands_json "${2:-}" ;;
  --ingest) handle_utterance "${2:-}" ;;
  --toggle) if is_running; then do_stop; else do_start; fi ;;
  --start|start) do_start ;;
  *) usage; exit 2 ;;
esac
