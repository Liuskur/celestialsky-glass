#!/usr/bin/env bash
# Koollook STT: local English dictation → clip buffer → Plasma 6 widget.
set -euo pipefail

export PATH="/usr/bin:/usr/local/bin:${PATH:-/bin}"

RESONIDER="${RESONIDER:-/opt/Grok/ResoNider}"
WHISPER_BIN="${WHISPER_BIN:-$RESONIDER/third_party/whisper.cpp/build-en-best/bin/whisper-stream}"
MODEL="${KOOLLOOK_STT_MODEL:-$RESONIDER/models/ggml-tiny.en-q5_1.bin}"
LANG="${KOOLLOOK_STT_LANG:-en}"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
PIDFILE="$RUNTIME/koollook-stt.pid"
LOG="${KOOLLOOK_STT_LOG:-$RUNTIME/koollook-stt.log}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/koollook"
CLIP="$STATE/clip.txt"
STATUS_FILE="$STATE/status"
SESSION_ENV="$STATE/session.env"
COMMANDS_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/koollook/stt-commands.json"

mkdir -p "$STATE" "$(dirname "$COMMANDS_JSON")"
[[ -f "$CLIP" ]] || : >"$CLIP"

usage() {
  cat <<'U'
Usage: koollook-stt [--start|--stop|--status|--toggle|--list-sources]
                    [--clear-clip|--send-clip|--ingest TEXT]
                    [--write-commands-json JSON]
Clip: ~/.local/state/koollook/clip.txt
Commands: ~/.config/koollook/stt-commands.json
Send clip types the buffer into the focused field (wtype).
U
}

ensure_commands_json() {
  mkdir -p "$(dirname "$COMMANDS_JSON")"
  if [[ ! -f "$COMMANDS_JSON" ]]; then
    local def
    def="$(cd "$(dirname "$0")" && pwd)/commands.default.json"
    if [[ -f "$def" ]]; then
      cp -a "$def" "$COMMANDS_JSON"
    else
      printf '%s\n' '{"hard":[{"id":"clear-clip","name":"Delete clip","match":"delete clip","builtin":"clear-clip"},{"id":"send-clip","name":"Send clip","match":"send clip","builtin":"send-clip"}],"custom":[]}' >"$COMMANDS_JSON"
    fi
  fi
}

do_write_commands_json() {
  mkdir -p "$(dirname "$COMMANDS_JSON")"
  printf '%s\n' "$1" >"$COMMANDS_JSON"
  echo "commands written $COMMANDS_JSON"
}

match_command() {
  python3 - "$COMMANDS_JSON" "$1" <<'PY'
import json, re, sys
from pathlib import Path
path, uttered = sys.argv[1], sys.argv[2]
def norm(s):
    s = re.sub(r"[^a-z0-9 ]+", " ", s.lower())
    return re.sub(r" +", " ", s).strip()
n = norm(uttered)
try:
    data = json.loads(Path(path).read_text())
except Exception:
    print("NONE")
    raise SystemExit(0)
for item in data.get("hard") or []:
    m = norm(item.get("match") or "")
    if m and m in n:
        print("BUILTIN", item.get("builtin") or "")
        print("REST", n.replace(m, " ", 1).strip())
        raise SystemExit(0)
for item in data.get("custom") or []:
    m = norm(item.get("match") or "")
    if m and m in n:
        print("RUN", item.get("command") or "")
        raise SystemExit(0)
print("NONE")
PY
}

list_sources() {
  command -v pactl >/dev/null || { echo "pactl not found"; return 1; }
  pactl list sources short
}

pick_source() {
  local want="${KOOLLOOK_STT_SOURCE:-auto}"
  command -v pactl >/dev/null || return 0
  if [[ "$want" != "auto" && -n "$want" ]]; then
    printf '%s' "$want"
    return 0
  fi
  pactl list sources short 2>/dev/null | awk '{print $2}' | grep -iE 'kdeconnect' | head -1 || true
}

save_session_env() {
  mkdir -p "$STATE"
  umask 077
  {
    printf 'WAYLAND_DISPLAY=%q\n' "${WAYLAND_DISPLAY:-}"
    printf 'XDG_RUNTIME_DIR=%q\n' "${XDG_RUNTIME_DIR:-}"
    printf 'DISPLAY=%q\n' "${DISPLAY:-}"
    printf 'DBUS_SESSION_BUS_ADDRESS=%q\n' "${DBUS_SESSION_BUS_ADDRESS:-}"
  } >"$SESSION_ENV"
}

load_session_env() {
  if [[ -f "$SESSION_ENV" ]]; then
    local k v
    while IFS='=' read -r k v; do
      case "$k" in
        WAYLAND_DISPLAY|XDG_RUNTIME_DIR|DISPLAY|DBUS_SESSION_BUS_ADDRESS) ;;
        *) continue ;;
      esac
      if [[ -z "${!k:-}" && -n "$v" ]]; then
        eval "export $k=$v"
      fi
    done <"$SESSION_ENV"
  fi
  if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    local rd="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    export XDG_RUNTIME_DIR="$rd"
    if [[ -S "$rd/wayland-0" ]]; then
      export WAYLAND_DISPLAY=wayland-0
    elif [[ -S "$rd/wayland-1" ]]; then
      export WAYLAND_DISPLAY=wayland-1
    fi
  fi
}

type_via_wtype() {
  local t="$1" bin out rc
  bin="$(command -v wtype || true)"
  [[ -n "$bin" ]] || return 1
  set +e
  out="$(printf '%s' "$t" | "$bin" -s 80 - 2>&1)"
  rc=$?
  set -e
  if [[ $rc -eq 0 && "$out" != *"does not support"* ]]; then
    return 0
  fi
  printf 'wtype failed rc=%s %s\n' "$rc" "$out" >>"$LOG"
  return 1
}

type_via_atspi() {
  local t="$1"
  command -v python3 >/dev/null || return 1
  python3 - "$t" <<'PY'
import sys
text = sys.argv[1]
if not text:
    raise SystemExit(0)
try:
    import gi
    gi.require_version("Atspi", "2.0")
    from gi.repository import Atspi
except Exception:
    raise SystemExit(1)
try:
    Atspi.init()
except Exception:
    pass
focused = None

def walk(acc, depth):
    global focused
    if focused is not None or acc is None or depth > 24:
        return
    try:
        st = acc.get_state_set()
        if st.contains(Atspi.StateType.FOCUSED):
            focused = acc
            return
    except Exception:
        pass
    try:
        n = acc.get_child_count()
    except Exception:
        return
    for i in range(max(0, int(n))):
        try:
            ch = acc.get_child_at_index(i)
        except Exception:
            continue
        walk(ch, depth + 1)
        if focused is not None:
            return

try:
    walk(Atspi.get_desktop(0), 0)
except Exception:
    pass
if focused is not None:
    try:
        if focused.is_editable_text():
            off = 0
            try:
                off = focused.get_text_iface().get_caret_offset()
            except Exception:
                off = 0
            if focused.insert_text(int(off), text, len(text)):
                raise SystemExit(0)
            if focused.set_text_contents(text):
                raise SystemExit(0)
    except SystemExit:
        raise
    except Exception:
        pass
try:
    if Atspi.generate_keyboard_event(0, text, Atspi.KeySynthType.STRING):
        raise SystemExit(0)
except Exception:
    pass
raise SystemExit(1)
PY
}

type_text() {
  local t="$1"
  [[ -z "$t" ]] && return 0
  load_session_env
  case "${KOOLLOOK_STT_TYPE:-auto}" in
    wtype) type_via_wtype "$t"; return $? ;;
    ydotool) command -v ydotool >/dev/null && ydotool type -- "$t"; return $? ;;
    xdotool) command -v xdotool >/dev/null && xdotool type --delay 8 -- "$t"; return $? ;;
    atspi) type_via_atspi "$t"; return $? ;;
  esac
  type_via_wtype "$t" && return 0
  if command -v ydotool >/dev/null && ydotool type -- "$t"; then return 0; fi
  type_via_atspi "$t" && return 0
  if command -v xdotool >/dev/null && xdotool type --delay 8 -- "$t"; then return 0; fi
  return 1
}

clip_write() {
  local tmp
  tmp="$(mktemp "$STATE/clip.XXXXXX")"
  printf '%s' "$1" >"$tmp"
  mv -f "$tmp" "$CLIP"
}

clip_read() {
  [[ -f "$CLIP" ]] && cat "$CLIP" || true
}

clip_append() {
  local add="$1" cur
  cur="$(clip_read)"
  if [[ -z "$cur" ]]; then clip_write "$add"; else clip_write "$cur $add"; fi
}

do_clear_clip() {
  clip_write ""
  echo "idle" >"$STATUS_FILE"
  echo "clip cleared"
  notify-send -a Koollook "STT" "Clip deleted" 2>/dev/null || true
}

do_send_clip() {
  local t
  load_session_env
  t="$(clip_read)"
  t="${t%"${t##*[![:space:]]}"}"
  if [[ -z "$t" ]]; then echo "clip empty"; return 0; fi
  printf '%s' "$t" >"$STATE/last-sent.txt"
  command -v wl-copy >/dev/null && printf '%s' "$t" | wl-copy || true
  if type_text "$t"; then
    clip_write ""
    echo "sent" >"$STATUS_FILE"
    echo "clip sent"
    notify-send -a Koollook "STT" "Clip typed into the focused field" 2>/dev/null || true
    return 0
  fi
  echo "sent-clipboard" >"$STATUS_FILE"
  echo "clip copied (could not type into focus)"
  notify-send -a Koollook "STT" "Clip copied — paste with Ctrl+V (wtype blocked by compositor)" 2>/dev/null || true
}

keep_text() {
  local t="$1"
  t="$(printf '%s' "$t" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [[ -z "$t" ]] && return 1
  case "$t" in
    "[Start speaking]"|"[BLANK_AUDIO]"|"[blank audio]"|"[Music]"|"[music]"|"[Silence]"|"[BLANK]") return 1 ;;
  esac
  [[ "$t" =~ ^\[.*\]$ ]] && return 1
  printf '%s' "$t"
}

handle_utterance() {
  local out="$1" result kind payload rest=""
  ensure_commands_json
  result="$(match_command "$out" || true)"
  kind="$(printf '%s\n' "$result" | awk 'NR==1{print $1}')"
  payload="$(printf '%s\n' "$result" | awk 'NR==1{ $1=""; sub(/^ /,""); print }')"
  rest="$(printf '%s\n' "$result" | awk 'NR==2 && $1=="REST"{ $1=""; sub(/^ /,""); print }')"
  case "$kind" in
    BUILTIN)
      case "$payload" in
        clear-clip) do_clear_clip ;;
        send-clip)
          [[ -n "$rest" ]] && clip_append "$rest"
          do_send_clip
          ;;
        *) clip_append "$out" ;;
      esac
      ;;
    RUN)
      if [[ -n "$payload" ]]; then
        bash -lc "$payload" >/dev/null 2>&1 &
        notify-send -a Koollook "STT" "Ran command" 2>/dev/null || true
      fi
      ;;
    *) clip_append "$out" ;;
  esac
}

is_running() {
  [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

do_stop() {
  if [[ -f "$PIDFILE" ]]; then
    local p
    p="$(cat "$PIDFILE")"
    kill "$p" 2>/dev/null || true
    pkill -P "$p" 2>/dev/null || true
    rm -f "$PIDFILE"
  fi
  echo "stopped" >"$STATUS_FILE"
  echo "koollook-stt stopped"
}

do_status() {
  if is_running; then
    echo "running pid=$(cat "$PIDFILE")"
    echo "listening" >"$STATUS_FILE"
    return 0
  fi
  echo "stopped"
  echo "stopped" >"$STATUS_FILE"
  return 1
}

do_start() {
  if is_running; then
    echo "already running pid=$(cat "$PIDFILE")"
    return 0
  fi
  [[ -x "$WHISPER_BIN" ]] || { echo "missing $WHISPER_BIN" >&2; exit 1; }
  [[ -f "$MODEL" ]] || { echo "missing model $MODEL" >&2; exit 1; }
  load_session_env
  [[ -n "${WAYLAND_DISPLAY:-}" ]] && save_session_env
  local src
  src="$(pick_source || true)"
  if [[ -n "$src" ]]; then
    export PULSE_SOURCE="$src"
    echo "audio source: $src"
  else
    echo "audio source: default Pulse/PipeWire input"
  fi
  export LD_LIBRARY_PATH="$(dirname "$WHISPER_BIN"):${LD_LIBRARY_PATH:-}"
  mkdir -p "$(dirname "$PIDFILE")" "$STATE"
  echo "listening" >"$STATUS_FILE"
  (
    local buf="" in_block=0
    "$WHISPER_BIN" -m "$MODEL" -l "$LANG" --step 800 --length 5000 --keep 200 \
      --threads "${KOOLLOOK_STT_THREADS:-4}" \
      2>>"$LOG" | while IFS= read -r line; do
        if [[ "$line" == "### Transcription "*START* ]]; then
          in_block=1; buf=""; continue
        fi
        if [[ "$line" == "### Transcription "*END* ]]; then
          in_block=0
          local out
          out="$(keep_text "$buf" || true)"
          if [[ -n "$out" ]]; then
            handle_utterance "$out" || true
            printf 'clip: %s\n' "$out" >>"$LOG"
          fi
          buf=""; continue
        fi
        if [[ $in_block -eq 1 ]]; then buf+="$line"; fi
      done
  ) &
  echo $! >"$PIDFILE"
  echo "koollook-stt started pid=$(cat "$PIDFILE") clip=$CLIP"
  notify-send -a Koollook "STT" "Listening — buffer in STT clip widget" 2>/dev/null || true
}

ensure_commands_json
cmd="${1:---start}"
case "$cmd" in
  -h|--help) usage ;;
  --list-sources) list_sources ;;
  --stop) do_stop ;;
  --status) do_status ;;
  --clear-clip|--delete-clip) do_clear_clip ;;
  --send-clip) do_send_clip ;;
  --write-commands-json) do_write_commands_json "${2:-}" ;;
  --ingest) handle_utterance "${2:-}" ;;
  --toggle) if is_running; then do_stop; else do_start; fi ;;
  --start|start) do_start ;;
  *) usage; exit 2 ;;
esac
