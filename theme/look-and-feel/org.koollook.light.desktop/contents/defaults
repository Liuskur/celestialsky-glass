[kdeglobals][General]
ColorScheme=KoollookLight
AccentColor=0,160,168
LastUsedCustomAccentColor=0,160,168

[kdeglobals][Icons]
Theme=Koollook

[kdeglobals][KDE]
widgetStyle=Breeze
LookAndFeelPackage=org.koollook.light

[kcminputrc][Mouse]
cursorTheme=Qogir-Ubuntu-Dark
cursorSize=24

[plasmarc][Theme]
name=Koollook

[ksplashrc][KSplash]
Engine=KSplashQML
Theme=org.koollook.light

[kwinrc][org.kde.kdecoration2]
BorderSizeAuto=false
ButtonsOnLeft=M
ButtonsOnRight=IAX
NoPlugin=false
library=org.kde.kwin.aurorae.v2
theme=__aurorae__svg__Koollook

[Sounds]
Theme=freedesktop

[kwinrc][Windows]
Placement=Smart
ActivationDesktopPolicy=2

[kwinrc][TabBox]
LayoutName=thumbnail_grid

[kwinrc][WindowSwitcher]
LayoutName=thumbnail_grid

[kwinrc][DesktopSwitcher]
LayoutName=org.kde.breeze.desktop

[kwinrc][Plugins]
hidecursorEnabled=true
slideEnabled=false
translucencyEnabled=true

[kwinrc][Effect-translucency]
ExcludeFullScreen=true
IndividualMenuConfig=true
MoveResize=63
DropdownMenus=66
PopupMenus=66
TornOffMenus=67

[Wallpaper]
defaultWallpaperTheme=Koollook-Light
defaultFileSuffix=.png
